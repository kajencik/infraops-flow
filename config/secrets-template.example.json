{
  "schemaVersion": 1,
  "secretStore": {
    "provider": "your-password-manager",
    "note": "Store real passwords, API keys, private keys, and recovery codes outside this repo."
  },
  "items": [
    {
      "name": "infra/router",
      "type": "ssh-access",
      "contains": ["privateKey", "optionalPassphrase"],
      "repoMetadata": "config/ssh-aliases.example.json#router"
    },
    {
      "name": "infra/core-host",
      "type": "ssh-access",
      "contains": ["privateKey", "recoveryNotes"],
      "repoMetadata": "config/ssh-aliases.example.json#core-host"
    }
  ]
}