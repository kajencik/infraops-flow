provider_label         = "generic-cloud"
region                 = "region-a"
environment_name       = "cloud-wg-core"
hub_node_name          = "cloud-hub-node"
hub_instance_class     = "small-utility-vm"
hub_image_label        = "linux-cloud-image"
hub_private_address    = "10.40.0.10"
network_appliance_name = "cloud-edge-appliance"
network_appliance_class = "managed-edge-small"
exposure_strategy      = "public-ip-through-appliance"
management_plane       = "provider-console-and-ssh"
protected_cidr_labels  = ["vpn-clients", "private-services"]
cost_profile_name      = "generic-cloud-wg-lab"